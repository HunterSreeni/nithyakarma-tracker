[
  {
    "id": "dhyanam-1",
    "type": "dhyanam",
    "sanskrit": "सिन्दूरारुणविग्रहां त्रिनयनां माणिक्यमौलिस्फुरत्\nतारानायकशेखरां स्मितमुखीमापीनवक्षोरुहाम् ।\nपाणिभ्यामलिपूर्णरत्नचषकं रक्तोत्पलं विभ्रतीं\nसौम्यां रत्नघटस्थरक्तचरणां ध्यायेत्परामम्बिकाम्"
  },
  {
    "id": "dhyanam-2",
    "type": "dhyanam",
    "sanskrit": "अरुणां करुणातरङ्गिताक्षीं\nधृतपाशाङ्कुशपुष्पबाणचापाम् ।\nअणिमादिभिरावृतां मयुखैः\nअहमित्येव विभावये भवानीम्"
  },
  {
    "id": "dhyanam-3",
    "type": "dhyanam",
    "sanskrit": "ध्यायेत्पद्मासनस्थां विकसितवदनां पद्मपत्रायताक्षीं\nहेमाभां पीतवस्त्रां करकलितलसद्धेमपद्मां वराङ्गीम् ।\nसर्वालङ्कारयुक्तां सततमभयदां भक्तनम्रां भवानीं\nश्रीविद्यां शान्तमूर्तिं सकलसुरनुतां सर्वसम्पत्प्रदात्रीम्"
  },
  {
    "id": "dhyanam-4",
    "type": "dhyanam",
    "sanskrit": "सकुङ्कुमविलेपनामलिकचुम्बिकस्तूरिकां\nसमन्दहसितेक्षणां सशरचापपाशाङ्कुशाम् ।\nअशेषजनमोहिनीमरुणमाल्यभूषाम्बरां\nजपाकुसुमभासुरां जपविधौ स्मरेदम्बिकाम्"
  },
  {
    "id": "shloka-1",
    "type": "shloka",
    "sanskrit": "ॐ श्रीमाता श्रीमहाराज्ञी श्रीमत्सिंहासनेश्वरी ।\nचिदग्निकुण्डसम्भूता देवकार्यसमुद्यता"
  },
  {
    "id": "shloka-2",
    "type": "shloka",
    "sanskrit": "उद्यद्भानुसहस्राभा चतुर्बाहुसमन्विता ।\nरागस्वरूपपाशाढ्या क्रोधाकाराङ्कुशोज्ज्वला"
  },
  {
    "id": "shloka-3",
    "type": "shloka",
    "sanskrit": "मनोरूपेक्षुकोदण्डा पञ्चतन्मात्रसायका ।\nनिजारुणप्रभापूरमज्जद्ब्रह्माण्डमण्डला"
  },
  {
    "id": "shloka-4",
    "type": "shloka",
    "sanskrit": "चम्पकाशोकपुन्नागसौगन्धिकलसत्कचा ।\nकुरुविन्दमणिश्रेणीकनत्कोटीरमण्डिता"
  },
  {
    "id": "shloka-5",
    "type": "shloka",
    "sanskrit": "अष्टमीचन्द्रविभ्राजदलिकस्थलशोभिता ।\nमुखचन्द्रकलङ्काभमृगनाभिविशेषका"
  },
  {
    "id": "shloka-6",
    "type": "shloka",
    "sanskrit": "वदनस्मरमाङ्गल्यगृहतोरणचिल्लिका ।\nवक्त्रलक्ष्मीपरीवाहचलन्मीनाभलोचना"
  },
  {
    "id": "shloka-7",
    "type": "shloka",
    "sanskrit": "नवचम्पकपुष्पाभनासादण्डविराजिता ।\nताराकान्तितिरस्कारिनासाभरणभासुरा"
  },
  {
    "id": "shloka-8",
    "type": "shloka",
    "sanskrit": "कदम्बमञ्जरीकॢप्तकर्णपूरमनोहरा ।\nताटङ्कयुगलीभूततपनोडुपमण्डला"
  },
  {
    "id": "shloka-9",
    "type": "shloka",
    "sanskrit": "पद्मरागशिलादर्शपरिभाविकपोलभूः ।\nनवविद्रुमबिम्बश्रीन्यक्कारिरदनच्छदा"
  },
  {
    "id": "shloka-10",
    "type": "shloka",
    "sanskrit": "शुद्धविद्याङ्कुराकारद्विजपङ्क्तिद्वयोज्ज्वला ।\nकर्पूरवीटिकामोदसमाकर्षिदिगन्तरा"
  },
  {
    "id": "shloka-11",
    "type": "shloka",
    "sanskrit": "निजसल्लापमाधुर्यविनिर्भर्त्सितकच्छपी ।\nमन्दस्मितप्रभापूरमज्जत्कामेशमानसा"
  },
  {
    "id": "shloka-12",
    "type": "shloka",
    "sanskrit": "अनाकलितसादृश्यचिबुकश्रीविराजिता ।\nकामेशबद्धमाङ्गल्यसूत्रशोभितकन्धरा"
  },
  {
    "id": "shloka-13",
    "type": "shloka",
    "sanskrit": "कनकाङ्गदकेयूरकमनीयभुजान्विता ।\nरत्नग्रैवेयचिन्ताकलोलमुक्ताफलान्विता"
  },
  {
    "id": "shloka-14",
    "type": "shloka",
    "sanskrit": "कामेश्वरप्रेमरत्नमणिप्रतिपणस्तनी ।\nनाभ्यालवालरोमालिलताफलकुचद्वयी"
  },
  {
    "id": "shloka-15",
    "type": "shloka",
    "sanskrit": "लक्ष्यरोमलताधारतासमुन्नेयमध्यमा ।\nस्तनभारदलन्मध्यपट्टबन्धवलित्रया"
  },
  {
    "id": "shloka-16",
    "type": "shloka",
    "sanskrit": "अरुणारुणकौसुम्भवस्त्रभास्वत्कटीतटी ।\nरत्नकिङ्किणिकारम्यरशनादामभूषिता"
  },
  {
    "id": "shloka-17",
    "type": "shloka",
    "sanskrit": "कामेशज्ञातसौभाग्यमार्दवोरुद्वयान्विता ।\nमाणिक्यमुकुटाकारजानुद्वयविराजिता"
  },
  {
    "id": "shloka-18",
    "type": "shloka",
    "sanskrit": "इन्द्रगोपपरिक्षिप्तस्मरतूणाभजङ्घिका ।\nगूढगुल्फा कूर्मपृष्ठजयिष्णुप्रपदान्विता"
  },
  {
    "id": "shloka-19",
    "type": "shloka",
    "sanskrit": "नखदीधितिसंछन्ननमज्जनतमोगुणा ।\nपदद्वयप्रभाजालपराकृतसरोरुहा"
  },
  {
    "id": "shloka-20",
    "type": "shloka",
    "sanskrit": "सिञ्जानमणिमञ्जीरमण्डितश्रीपदाम्बुजा ।\nमरालीमन्दगमना महालावण्यशेवधिः"
  },
  {
    "id": "shloka-21",
    "type": "shloka",
    "sanskrit": "सर्वारुणाऽनवद्याङ्गी सर्वाभरणभूषिता ।\nशिवकामेश्वराङ्कस्था शिवा स्वाधीनवल्लभा"
  },
  {
    "id": "shloka-22",
    "type": "shloka",
    "sanskrit": "सुमेरुमध्यशृङ्गस्था श्रीमन्नगरनायिका ।\nचिन्तामणिगृहान्तस्था पञ्चब्रह्मासनस्थिता"
  },
  {
    "id": "shloka-23",
    "type": "shloka",
    "sanskrit": "महापद्माटवीसंस्था कदम्बवनवासिनी ।\nसुधासागरमध्यस्था कामाक्षी कामदायिनी"
  },
  {
    "id": "shloka-24",
    "type": "shloka",
    "sanskrit": "देवर्षिगणसंघातस्तूयमानात्मवैभवा ।\nभण्डासुरवधोद्युक्तशक्तिसेनासमन्विता"
  },
  {
    "id": "shloka-25",
    "type": "shloka",
    "sanskrit": "सम्पत्करीसमारूढसिन्धुरव्रजसेविता ।\nअश्वारूढाधिष्ठिताश्वकोटिकोटिभिरावृता"
  },
  {
    "id": "shloka-26",
    "type": "shloka",
    "sanskrit": "चक्रराजरथारूढसर्वायुधपरिष्कृता ।\nगेयचक्ररथारूढमन्त्रिणीपरिसेविता"
  },
  {
    "id": "shloka-27",
    "type": "shloka",
    "sanskrit": "किरिचक्ररथारूढदण्डनाथापुरस्कृता ।\nज्वालामालिनिकाक्षिप्तवह्निप्राकारमध्यगा"
  },
  {
    "id": "shloka-28",
    "type": "shloka",
    "sanskrit": "भण्डसैन्यवधोद्युक्तशक्तिविक्रमहर्षिता ।\nनित्यापराक्रमाटोपनिरीक्षणसमुत्सुका"
  },
  {
    "id": "shloka-29",
    "type": "shloka",
    "sanskrit": "भण्डपुत्रवधोद्युक्तबालाविक्रमनन्दिता ।\nमन्त्रिण्यम्बाविरचितविषङ्गवधतोषिता"
  },
  {
    "id": "shloka-30",
    "type": "shloka",
    "sanskrit": "विशुक्रप्राणहरणवाराहीवीर्यनन्दिता ।\nकामेश्वरमुखालोककल्पितश्रीगणेश्वरा"
  },
  {
    "id": "shloka-31",
    "type": "shloka",
    "sanskrit": "महागणेशनिर्भिन्नविघ्नयन्त्रप्रहर्षिता ।\nभण्डासुरेन्द्रनिर्मुक्तशस्त्रप्रत्यस्त्रवर्षिणी"
  },
  {
    "id": "shloka-32",
    "type": "shloka",
    "sanskrit": "कराङ्गुलिनखोत्पन्ननारायणदशाकृतिः ।\nमहापाशुपतास्त्राग्निनिर्दग्धासुरसैनिका"
  },
  {
    "id": "shloka-33",
    "type": "shloka",
    "sanskrit": "कामेश्वरास्त्रनिर्दग्धसभण्डासुरशून्यका ।\nब्रह्मोपेन्द्रमहेन्द्रादिदेवसंस्तुतवैभवा"
  },
  {
    "id": "shloka-34",
    "type": "shloka",
    "sanskrit": "हरनेत्राग्निसंदग्धकामसञ्जीवनौषधिः ।\nश्रीमद्वाग्भवकूटैकस्वरूपमुखपङ्कजा"
  },
  {
    "id": "shloka-35",
    "type": "shloka",
    "sanskrit": "कण्ठाधःकटिपर्यन्तमध्यकूटस्वरूपिणी ।\nशक्तिकूटैकतापन्नकट्यधोभागधारिणी"
  },
  {
    "id": "shloka-36",
    "type": "shloka",
    "sanskrit": "मूलमन्त्रात्मिका मूलकूटत्रयकलेवरा ।\nकुलामृतैकरसिका कुलसंकेतपालिनी"
  },
  {
    "id": "shloka-37",
    "type": "shloka",
    "sanskrit": "कुलाङ्गना कुलान्तस्था कौलिनी कुलयोगिनी ।\nअकुला समयान्तस्था समयाचारतत्परा"
  },
  {
    "id": "shloka-38",
    "type": "shloka",
    "sanskrit": "मूलाधारैकनिलया ब्रह्मग्रन्थिविभेदिनी ।\nमणिपूरान्तरुदिता विष्णुग्रन्थिविभेदिनी"
  },
  {
    "id": "shloka-39",
    "type": "shloka",
    "sanskrit": "आज्ञाचक्रान्तरालस्था रुद्रग्रन्थिविभेदिनी ।\nसहस्राराम्बुजारूढा सुधासाराभिवर्षिणी"
  },
  {
    "id": "shloka-40",
    "type": "shloka",
    "sanskrit": "तडिल्लतासमरुचिः षट्चक्रोपरिसंस्थिता ।\nमहासक्तिः कुण्डलिनी बिसतन्तुतनीयसी"
  },
  {
    "id": "shloka-41",
    "type": "shloka",
    "sanskrit": "भवानी भावनागम्या भवारण्यकुठारिका ।\nभद्रप्रिया भद्रमूर्तिर्भक्तसौभाग्यदायिनी"
  },
  {
    "id": "shloka-42",
    "type": "shloka",
    "sanskrit": "भक्तिप्रिया भक्तिगम्या भक्तिवश्या भयापहा ।\nशाम्भवी शारदाराध्या शर्वाणी शर्मदायिनी"
  },
  {
    "id": "shloka-43",
    "type": "shloka",
    "sanskrit": "शाङ्करी श्रीकरी साध्वी शरच्चन्द्रनिभानना ।\nशातोदरी शान्तिमती निराधारा निरञ्जना"
  },
  {
    "id": "shloka-44",
    "type": "shloka",
    "sanskrit": "निर्लेपा निर्मला नित्या निराकारा निराकुला ।\nनिर्गुणा निष्कला शान्ता निष्कामा निरुपप्लवा"
  },
  {
    "id": "shloka-45",
    "type": "shloka",
    "sanskrit": "नित्यमुक्ता निर्विकारा निष्प्रपञ्चा निराश्रया ।\nनित्यशुद्धा नित्यबुद्धा निरवद्या निरन्तरा"
  },
  {
    "id": "shloka-46",
    "type": "shloka",
    "sanskrit": "निष्कारणा निष्कलङ्का निरुपाधिर्निरीश्वरा ।\nनीरागा रागमथनी निर्मदा मदनाशिनी"
  },
  {
    "id": "shloka-47",
    "type": "shloka",
    "sanskrit": "निश्चिन्ता निरहंकारा निर्मोहा मोहनाशिनी ।\nनिर्ममा ममताहन्त्री निष्पापा पापनाशिनी"
  },
  {
    "id": "shloka-48",
    "type": "shloka",
    "sanskrit": "निष्क्रोधा क्रोधशमनी निर्लोभा लोभनाशिनी ।\nनिःसंशया संशयघ्नी निर्भवा भवनाशिनी"
  },
  {
    "id": "shloka-49",
    "type": "shloka",
    "sanskrit": "निर्विकल्पा निराबाधा निर्भेदा भेदनाशिनी ।\nनिर्नाशा मृत्युमथनी निष्क्रिया निष्परिग्रहा"
  },
  {
    "id": "shloka-50",
    "type": "shloka",
    "sanskrit": "निस्तुला नीलचिकुरा निरपाया निरत्यया ।\nदुर्लभा दुर्गमा दुर्गा दुःखहन्त्री सुखप्रदा"
  },
  {
    "id": "shloka-51",
    "type": "shloka",
    "sanskrit": "दुष्टदूरा दुराचारशमनी दोषवर्जिता ।\nसर्वज्ञा सान्द्रकरुणा समानाधिकवर्जिता"
  },
  {
    "id": "shloka-52",
    "type": "shloka",
    "sanskrit": "सर्वशक्तिमयी सर्वमङ्गला सद्गतिप्रदा ।\nसर्वेश्वरी सर्वमयी सर्वमन्त्रस्वरूपिणी"
  },
  {
    "id": "shloka-53",
    "type": "shloka",
    "sanskrit": "सर्वयन्त्रात्मिका सर्वतन्त्ररूपा मनोन्मनी ।\nमाहेश्वरी महादेवी महालक्ष्मीर्मृडप्रिया"
  },
  {
    "id": "shloka-54",
    "type": "shloka",
    "sanskrit": "महारूपा महापूज्या महापातकनाशिनी ।\nमहामाया महासत्त्वा महाशक्तिर्महारतिः"
  },
  {
    "id": "shloka-55",
    "type": "shloka",
    "sanskrit": "महाभोगा महैश्वर्या महावीर्या महाबला ।\nमहाबुद्धिर्महासिद्धिर्महायोगेश्वरेश्वरी"
  },
  {
    "id": "shloka-56",
    "type": "shloka",
    "sanskrit": "महातन्त्रा महामन्त्रा महायन्त्रा महासना ।\nमहायागक्रमाराध्या महाभैरवपूजिता"
  },
  {
    "id": "shloka-57",
    "type": "shloka",
    "sanskrit": "महेश्वरमहाकल्पमहाताण्डवसाक्षिणी ।\nमहाकामेशमहिषी महात्रिपुरसुन्दरी"
  },
  {
    "id": "shloka-58",
    "type": "shloka",
    "sanskrit": "चतुःषष्ट्युपचाराढ्या चतुःषष्टिकलामयी ।\nमहाचतुःषष्टिकोटियोगिनीगणसेविता"
  },
  {
    "id": "shloka-59",
    "type": "shloka",
    "sanskrit": "मनुविद्या चन्द्रविद्या चन्द्रमण्डलमध्यगा ।\nचारुरूपा चारुहासा चारुचन्द्रकलाधरा"
  },
  {
    "id": "shloka-60",
    "type": "shloka",
    "sanskrit": "चराचरजगन्नाथा चक्रराजनिकेतना ।\nपार्वती पद्मनयना पद्मरागसमप्रभा"
  },
  {
    "id": "shloka-61",
    "type": "shloka",
    "sanskrit": "पञ्चप्रेतासनासीना पञ्चब्रह्मस्वरूपिणी ।\nचिन्मयी परमानन्दा विज्ञानघनरूपिणी"
  },
  {
    "id": "shloka-62",
    "type": "shloka",
    "sanskrit": "ध्यानध्यातृध्येयरूपा धर्माधर्मविवर्जिता ।\nविश्वरूपा जागरिणी स्वपन्ती तैजसात्मिका"
  },
  {
    "id": "shloka-63",
    "type": "shloka",
    "sanskrit": "सुप्ता प्राज्ञात्मिका तुर्या सर्वावस्थाविवर्जिता ।\nसृष्टिकर्त्री ब्रह्मरूपा गोप्त्री गोविन्दरूपिणी"
  },
  {
    "id": "shloka-64",
    "type": "shloka",
    "sanskrit": "संहारिणी रुद्ररूपा तिरोधानकरीश्वरी ।\nसदाशिवाऽनुग्रहदा पञ्चकृत्यपरायणा"
  },
  {
    "id": "shloka-65",
    "type": "shloka",
    "sanskrit": "भानुमण्डलमध्यस्था भैरवी भगमालिनी ।\nपद्मासना भगवती पद्मनाभसहोदरी"
  },
  {
    "id": "shloka-66",
    "type": "shloka",
    "sanskrit": "उन्मेषनिमिषोत्पन्नविपन्नभुवनावली ।\nसहस्रशीर्षवदना सहस्राक्षी सहस्रपात्"
  },
  {
    "id": "shloka-67",
    "type": "shloka",
    "sanskrit": "आब्रह्मकीटजननी वर्णाश्रमविधायिनी ।\nनिजाज्ञारूपनिगमा पुण्यापुण्यफलप्रदा"
  },
  {
    "id": "shloka-68",
    "type": "shloka",
    "sanskrit": "श्रुतिसीमन्तसिन्दूरीकृतपादाब्जधूलिका ।\nसकलागमसन्दोहशुक्तिसम्पुटमौक्तिका"
  },
  {
    "id": "shloka-69",
    "type": "shloka",
    "sanskrit": "पुरुषार्थप्रदा पूर्णा भोगिनी भुवनेश्वरी ।\nअम्बिकाऽनादिनिधना हरिब्रह्मेन्द्रसेविता"
  },
  {
    "id": "shloka-70",
    "type": "shloka",
    "sanskrit": "नारायणी नादरूपा नामरूपविवर्जिता ।\nह्रींकारी ह्रीमती हृद्या हेयोपादेयवर्जिता"
  },
  {
    "id": "shloka-71",
    "type": "shloka",
    "sanskrit": "राजराजार्चिता राज्ञी रम्या राजीवलोचना ।\nरञ्जनी रमणी रस्या रणत्किङ्किणिमेखला"
  },
  {
    "id": "shloka-72",
    "type": "shloka",
    "sanskrit": "रमा राकेन्दुवदना रतिरूपा रतिप्रिया ।\nरक्षाकरी राक्षसघ्नी रामा रमणलम्पटा"
  },
  {
    "id": "shloka-73",
    "type": "shloka",
    "sanskrit": "काम्या कामकलारूपा कदम्बकुसुमप्रिया ।\nकल्याणी जगतीकन्दा करुणारससागरा"
  },
  {
    "id": "shloka-74",
    "type": "shloka",
    "sanskrit": "कलावती कलालापा कान्ता कादम्बरीप्रिया ।\nवरदा वामनयना वारुणीमदविह्वला"
  },
  {
    "id": "shloka-75",
    "type": "shloka",
    "sanskrit": "विश्वाधिका वेदवेद्या विन्ध्याचलनिवासिनी ।\nविधात्री वेदजननी विष्णुमाया विलासिनी"
  },
  {
    "id": "shloka-76",
    "type": "shloka",
    "sanskrit": "क्षेत्रस्वरूपा क्षेत्रेशी क्षेत्रक्षेत्रज्ञपालिनी ।\nक्षयवृद्धिविनिर्मुक्ता क्षेत्रपालसमर्चिता"
  },
  {
    "id": "shloka-77",
    "type": "shloka",
    "sanskrit": "विजया विमला वन्द्या वन्दारुजनवत्सला ।\nवाग्वादिनी वामकेशी वह्निमण्डलवासिनी"
  },
  {
    "id": "shloka-78",
    "type": "shloka",
    "sanskrit": "भक्तिमत्कल्पलतिका पशुपाशविमोचिनी ।\nसंहृताशेषपाषण्डा सदाचारप्रवर्तिका"
  },
  {
    "id": "shloka-79",
    "type": "shloka",
    "sanskrit": "तापत्रयाग्निसन्तप्तसमाह्लादनचन्द्रिका ।\nतरुणी तापसाराध्या तनुमध्या तमोऽपहा"
  },
  {
    "id": "shloka-80",
    "type": "shloka",
    "sanskrit": "चितिस्तत्पदलक्ष्यार्था चिदेकरसरूपिणी ।\nस्वात्मानन्दलवीभूतब्रह्माद्यानन्दसन्ततिः"
  },
  {
    "id": "shloka-81",
    "type": "shloka",
    "sanskrit": "परा प्रत्यक्चितीरूपा पश्यन्ती परदेवता ।\nमध्यमा वैखरीरूपा भक्तमानसहंसिका"
  },
  {
    "id": "shloka-82",
    "type": "shloka",
    "sanskrit": "कामेश्वरप्राणनाडी कृतज्ञा कामपूजिता ।\nशृङ्गाररससम्पूर्णा जया जालन्धरस्थिता"
  },
  {
    "id": "shloka-83",
    "type": "shloka",
    "sanskrit": "ओड्याणपीठनिलया बिन्दुमण्डलवासिनी ।\nरहोयागक्रमाराध्या रहस्तर्पणतर्पिता"
  },
  {
    "id": "shloka-84",
    "type": "shloka",
    "sanskrit": "सद्यःप्रसादिनी विश्वसाक्षिणी साक्षिवर्जिता ।\nषडङ्गदेवतायुक्ता षाड्गुण्यपरिपूरिता"
  },
  {
    "id": "shloka-85",
    "type": "shloka",
    "sanskrit": "नित्यक्लिन्ना निरुपमा निर्वाणसुखदायिनी ।\nनित्याषोडशिकारूपा श्रीकण्ठार्धशरीरिणी"
  },
  {
    "id": "shloka-86",
    "type": "shloka",
    "sanskrit": "प्रभावती प्रभारूपा प्रसिद्धा परमेश्वरी ।\nमूलप्रकृतिरव्यक्ता व्यक्ताव्यक्तस्वरूपिणी"
  },
  {
    "id": "shloka-87",
    "type": "shloka",
    "sanskrit": "व्यापिनी विविधाकारा विद्याविद्यास्वरूपिणी ।\nमहाकामेशनयनकुमुदाह्लादकौमुदी"
  },
  {
    "id": "shloka-88",
    "type": "shloka",
    "sanskrit": "भक्तहार्दतमोभेदभानुमद्भानुसन्ततिः ।\nशिवदूती शिवाराध्या शिवमूर्तिः शिवङ्करी"
  },
  {
    "id": "shloka-89",
    "type": "shloka",
    "sanskrit": "शिवप्रिया शिवपरा शिष्टेष्टा शिष्टपूजिता ।\nअप्रमेया स्वप्रकाशा मनोवाचामगोचरा"
  },
  {
    "id": "shloka-90",
    "type": "shloka",
    "sanskrit": "चिच्छक्तिश् चेतनारूपा जडशक्तिर्जडात्मिका ।\nगायत्री व्याहृतिः सन्ध्या द्विजवृन्दनिषेविता"
  },
  {
    "id": "shloka-91",
    "type": "shloka",
    "sanskrit": "तत्त्वासना तत्त्वमयी पञ्चकोशान्तरस्थिता ।\nनिःसीममहिमा नित्ययौवना मदशालिनी"
  },
  {
    "id": "shloka-92",
    "type": "shloka",
    "sanskrit": "मदघूर्णितरक्ताक्षी मदपाटलगण्डभूः ।\nचन्दनद्रवदिग्धाङ्गी चाम्पेयकुसुमप्रिया"
  },
  {
    "id": "shloka-93",
    "type": "shloka",
    "sanskrit": "कुशला कोमलाकारा कुरुकुल्ला कुलेश्वरी ।\nकुलकुण्डालया कौलमार्गतत्परसेविता"
  },
  {
    "id": "shloka-94",
    "type": "shloka",
    "sanskrit": "कुमारगणनाथाम्बा तुष्टिः पुष्टिर्मतिर्धृतिः ।\nशान्तिः स्वस्तिमती कान्तिर्नन्दिनी विघ्ननाशिनी"
  },
  {
    "id": "shloka-95",
    "type": "shloka",
    "sanskrit": "तेजोवती त्रिनयना लोलाक्षीकामरूपिणी ।\nमालिनी हंसिनी माता मलयाचलवासिनी"
  },
  {
    "id": "shloka-96",
    "type": "shloka",
    "sanskrit": "सुमुखी नलिनी सुभ्रूः शोभना सुरनायिका ।\nकालकण्ठी कान्तिमती क्षोभिणी सूक्ष्मरूपिणी"
  },
  {
    "id": "shloka-97",
    "type": "shloka",
    "sanskrit": "वज्रेश्वरी वामदेवी वयोऽवस्थाविवर्जिता ।\nसिद्धेश्वरी सिद्धविद्या सिद्धमाता यशस्विनी"
  },
  {
    "id": "shloka-98",
    "type": "shloka",
    "sanskrit": "विशुद्धिचक्रनिलयाऽऽरक्तवर्णा त्रिलोचना ।\nखट्वाङ्गादिप्रहरणा वदनैकसमन्विता"
  },
  {
    "id": "shloka-99",
    "type": "shloka",
    "sanskrit": "पायसान्नप्रिया त्वक्स्था पशुलोकभयङ्करी ।\nअमृतादिमहाशक्तिसंवृता डाकिनीश्वरी"
  },
  {
    "id": "shloka-100",
    "type": "shloka",
    "sanskrit": "अनाहताब्जनिलया श्यामाभा वदनद्वया ।\nदंष्ट्रोज्ज्वलाऽक्षमालादिधरा रुधिरसंस्थिता"
  },
  {
    "id": "shloka-101",
    "type": "shloka",
    "sanskrit": "कालरात्र्यादिशक्त्यौघवृता स्निग्धौदनप्रिया ।\nमहावीरेन्द्रवरदा राकिण्यम्बास्वरूपिणी"
  },
  {
    "id": "shloka-102",
    "type": "shloka",
    "sanskrit": "मणिपूराब्जनिलया वदनत्रयसंयुता ।\nवज्रादिकायुधोपेता डामर्यादिभिरावृता"
  },
  {
    "id": "shloka-103",
    "type": "shloka",
    "sanskrit": "रक्तवर्णा मांसनिष्ठा गुडान्नप्रीतमानसा ।\nसमस्तभक्तसुखदा लाकिन्यम्बास्वरूपिणी"
  },
  {
    "id": "shloka-104",
    "type": "shloka",
    "sanskrit": "स्वाधिष्ठानाम्बुजगता चतुर्वक्त्रमनोहरा ।\nशूलाद्यायुधसम्पन्ना पीतवर्णाऽतिगर्विता"
  },
  {
    "id": "shloka-105",
    "type": "shloka",
    "sanskrit": "मेदोनिष्ठा मधुप्रीता बन्धिन्यादिसमन्विता ।\nदध्यन्नासक्तहृदया काकिनीरूपधारिणी"
  },
  {
    "id": "shloka-106",
    "type": "shloka",
    "sanskrit": "मूलाधाराम्बुजारूढा पञ्चवक्त्राऽस्थिसंस्थिता ।\nअङ्कुशादिप्रहरणा वरदादिनिषेविता"
  },
  {
    "id": "shloka-107",
    "type": "shloka",
    "sanskrit": "मुद्गौदनासक्तचित्ता साकिन्यम्बास्वरूपिणी ।\nआज्ञाचक्राब्जनिलया शुक्लवर्णा षडानना"
  },
  {
    "id": "shloka-108",
    "type": "shloka",
    "sanskrit": "मज्जासंस्था हंसवतीमुख्यशक्तिसमन्विता ।\nहरिद्रान्नैकरसिका हाकिनीरूपधारिणी"
  },
  {
    "id": "shloka-109",
    "type": "shloka",
    "sanskrit": "सहस्रदलपद्मस्था सर्ववर्णोपशोभिता ।\nसर्वायुधधरा शुक्लसंस्थिता सर्वतोमुखी"
  },
  {
    "id": "shloka-110",
    "type": "shloka",
    "sanskrit": "सर्वौदनप्रीतचित्ता याकिन्यम्बास्वरूपिणी ।\nस्वाहा स्वधाऽमतिर्मेधा श्रुतिः स्मृतिरनुत्तमा"
  },
  {
    "id": "shloka-111",
    "type": "shloka",
    "sanskrit": "पुण्यकीर्तिः पुण्यलभ्या पुण्यश्रवणकीर्तना ।\nपुलोमजार्चिता बन्धमोचनी बन्धुरालका"
  },
  {
    "id": "shloka-112",
    "type": "shloka",
    "sanskrit": "विमर्शरूपिणी विद्या वियदादिजगत्प्रसूः ।\nसर्वव्याधिप्रशमनी सर्वमृत्युनिवारिणी"
  },
  {
    "id": "shloka-113",
    "type": "shloka",
    "sanskrit": "अग्रगण्याऽचिन्त्यरूपा कलिकल्मषनाशिनी ।\nकात्यायनी कालहन्त्री कमलाक्षनिषेविता"
  },
  {
    "id": "shloka-114",
    "type": "shloka",
    "sanskrit": "ताम्बूलपूरितमुखी दाडिमीकुसुमप्रभा ।\nमृगाक्षी मोहिनी मुख्या मृडानी मित्ररूपिणी"
  },
  {
    "id": "shloka-115",
    "type": "shloka",
    "sanskrit": "नित्यतृप्ता भक्तनिधिर्नियन्त्री निखिलेश्वरी ।\nमैत्र्यादिवासनालभ्या महाप्रलयसाक्षिणी"
  },
  {
    "id": "shloka-116",
    "type": "shloka",
    "sanskrit": "परा शक्तिः परा निष्ठा प्रज्ञानघनरूपिणी ।\nमाध्वीपानालसा मत्ता मातृकावर्णरूपिणी"
  },
  {
    "id": "shloka-117",
    "type": "shloka",
    "sanskrit": "महाकैलासनिलया मृणालमृदुदोर्लता ।\nमहनीया दयामूर्तिर्महासाम्राज्यशालिनी"
  },
  {
    "id": "shloka-118",
    "type": "shloka",
    "sanskrit": "आत्मविद्या महाविद्या श्रीविद्या कामसेविता ।\nश्रीषोडशाक्षरीविद्या त्रिकूटा कामकोटिका"
  },
  {
    "id": "shloka-119",
    "type": "shloka",
    "sanskrit": "कटाक्षकिङ्करीभूतकमलाकोटिसेविता ।\nशिरःस्थिता चन्द्रनिभा भालस्थेन्द्रधनुःप्रभा"
  },
  {
    "id": "shloka-120",
    "type": "shloka",
    "sanskrit": "हृदयस्था रविप्रख्या त्रिकोणान्तरदीपिका ।\nदाक्षायणी दैत्यहन्त्री दक्षयज्ञविनाशिनी"
  },
  {
    "id": "shloka-121",
    "type": "shloka",
    "sanskrit": "दरान्दोलितदीर्घाक्षी दरहासोज्ज्वलन्मुखी ।\nगुरुमूर्तिर्गुणनिधिर्गोमाता गुहजन्मभूः"
  },
  {
    "id": "shloka-122",
    "type": "shloka",
    "sanskrit": "देवेशी दण्डनीतिस्था दहराकाशरूपिणी ।\nप्रतिपन्मुख्यराकान्ततिथिमण्डलपूजिता"
  },
  {
    "id": "shloka-123",
    "type": "shloka",
    "sanskrit": "कलात्मिका कलानाथा काव्यालापविनोदिनी ।\nसचामररमावाणीसव्यदक्षिणसेविता"
  },
  {
    "id": "shloka-124",
    "type": "shloka",
    "sanskrit": "आदिशक्तिरमेयाऽऽत्मा परमा पावनाकृतिः ।\nअनेककोटिब्रह्माण्डजननी दिव्यविग्रहा"
  },
  {
    "id": "shloka-125",
    "type": "shloka",
    "sanskrit": "क्लींकारी केवला गुह्या कैवल्यपददायिनी ।\nत्रिपुरा त्रिजगद्वन्द्या त्रिमूर्तिस्त्रिदशेश्वरी"
  },
  {
    "id": "shloka-126",
    "type": "shloka",
    "sanskrit": "त्र्यक्षरी दिव्यगन्धाढ्या सिन्दूरतिलकाञ्चिता ।\nउमा शैलेन्द्रतनया गौरी गन्धर्वसेविता"
  },
  {
    "id": "shloka-127",
    "type": "shloka",
    "sanskrit": "विश्वगर्भा स्वर्णगर्भाऽवरदा वागधीश्वरी ।\nध्यानगम्याऽपरिच्छेद्या ज्ञानदा ज्ञानविग्रहा"
  },
  {
    "id": "shloka-128",
    "type": "shloka",
    "sanskrit": "सर्ववेदान्तसंवेद्या सत्यानन्दस्वरूपिणी ।\nलोपामुद्रार्चिता लीलाकॢप्तब्रह्माण्डमण्डला"
  },
  {
    "id": "shloka-129",
    "type": "shloka",
    "sanskrit": "अदृश्या दृश्यरहिता विज्ञात्री वेद्यवर्जिता ।\nयोगिनी योगदा योग्या योगानन्दा युगन्धरा"
  },
  {
    "id": "shloka-130",
    "type": "shloka",
    "sanskrit": "इच्छाशक्तिज्ञानशक्तिक्रियाशक्तिस्वरूपिणी ।\nसर्वाधारा सुप्रतिष्ठा सदसद्रूपधारिणी"
  },
  {
    "id": "shloka-131",
    "type": "shloka",
    "sanskrit": "अष्टमूर्तिरजाजैत्री लोकयात्राविधायिनी ।\nएकाकिनी भूमरूपा निर्द्वैता द्वैतवर्जिता"
  },
  {
    "id": "shloka-132",
    "type": "shloka",
    "sanskrit": "अन्नदा वसुदा वृद्धा ब्रह्मात्मैक्यस्वरूपिणी ।\nबृहती ब्राह्मणी ब्राह्मी ब्रह्मानन्दा बलिप्रिया"
  },
  {
    "id": "shloka-133",
    "type": "shloka",
    "sanskrit": "भाषारूपा बृहत्सेना भावाभावविवर्जिता ।\nसुखाराध्या शुभकरी शोभना सुलभा गतिः"
  },
  {
    "id": "shloka-134",
    "type": "shloka",
    "sanskrit": "राजराजेश्वरी राज्यदायिनी राज्यवल्लभा ।\nराजत्कृपा राजपीठनिवेशितनिजाश्रिता"
  },
  {
    "id": "shloka-135",
    "type": "shloka",
    "sanskrit": "राज्यलक्ष्मीः कोशनाथा चतुरङ्गबलेश्वरी ।\nसाम्राज्यदायिनी सत्यसन्धा सागरमेखला"
  },
  {
    "id": "shloka-136",
    "type": "shloka",
    "sanskrit": "दीक्षिता दैत्यशमनी सर्वलोकवशङ्करी ।\nसर्वार्थदात्री सावित्री सच्चिदानन्दरूपिणी"
  },
  {
    "id": "shloka-137",
    "type": "shloka",
    "sanskrit": "देशकालापरिच्छिन्ना सर्वगा सर्वमोहिनी ।\nसरस्वती शास्त्रमयी गुहाम्बा गुह्यरूपिणी"
  },
  {
    "id": "shloka-138",
    "type": "shloka",
    "sanskrit": "सर्वोपाधिविनिर्मुक्ता सदाशिवपतिव्रता ।\nसम्प्रदायेश्वरी साध्वी गुरुमण्डलरूपिणी"
  },
  {
    "id": "shloka-139",
    "type": "shloka",
    "sanskrit": "कुलोत्तीर्णा भगाराध्या माया मधुमती मही ।\nगणाम्बा गुह्यकाराध्या कोमलाङ्गी गुरुप्रिया"
  },
  {
    "id": "shloka-140",
    "type": "shloka",
    "sanskrit": "स्वतन्त्रा सर्वतन्त्रेशी दक्षिणामूर्तिरूपिणी ।\nसनकादिसमाराध्या शिवज्ञानप्रदायिनी"
  },
  {
    "id": "shloka-141",
    "type": "shloka",
    "sanskrit": "चित्कलाऽऽनन्दकलिका प्रेमरूपा प्रियङ्करी ।\nनामपारायणप्रीता नन्दिविद्या नटेश्वरी"
  },
  {
    "id": "shloka-142",
    "type": "shloka",
    "sanskrit": "मिथ्याजगदधिष्ठाना मुक्तिदा मुक्तिरूपिणी ।\nलास्यप्रिया लयकरी लज्जा रम्भादिवन्दिता"
  },
  {
    "id": "shloka-143",
    "type": "shloka",
    "sanskrit": "भवदावसुधावृष्टिः पापारण्यदवानला ।\nदौर्भाग्यतूलवातूला जराध्वान्तरविप्रभा"
  },
  {
    "id": "shloka-144",
    "type": "shloka",
    "sanskrit": "भाग्याब्धिचन्द्रिका भक्तचित्तकेकिघनाघना ।\nरोगपर्वतदम्भोलिर्मृत्युदारुकुठारिका"
  },
  {
    "id": "shloka-145",
    "type": "shloka",
    "sanskrit": "महेश्वरी महाकाली महाग्रासा महाशना ।\nअपर्णा चण्डिका चण्डमुण्डासुरनिषूदिनी"
  },
  {
    "id": "shloka-146",
    "type": "shloka",
    "sanskrit": "क्षराक्षरात्मिका सर्वलोकेशी विश्वधारिणी ।\nत्रिवर्गदात्री सुभगा त्र्यम्बका त्रिगुणात्मिका"
  },
  {
    "id": "shloka-147",
    "type": "shloka",
    "sanskrit": "स्वर्गापवर्गदा शुद्धा जपापुष्पनिभाकृतिः ।\nओजोवती द्युतिधरा यज्ञरूपा प्रियव्रता"
  },
  {
    "id": "shloka-148",
    "type": "shloka",
    "sanskrit": "दुराराध्या दुराधर्षा पाटलीकुसुमप्रिया ।\nमहती मेरुनिलया मन्दारकुसुमप्रिया"
  },
  {
    "id": "shloka-149",
    "type": "shloka",
    "sanskrit": "वीराराध्या विराड्रूपा विरजा विश्वतोमुखी ।\nप्रत्यग्रूपा पराकाशा प्राणदा प्राणरूपिणी"
  },
  {
    "id": "shloka-150",
    "type": "shloka",
    "sanskrit": "मार्ताण्डभैरवाराध्या मन्त्रिणीन्यस्तराज्यधूः ।\nत्रिपुरेशी जयत्सेना निस्त्रैगुण्या परापरा"
  },
  {
    "id": "shloka-151",
    "type": "shloka",
    "sanskrit": "सत्यज्ञानानन्दरूपा सामरस्यपरायणा ।\nकपर्दिनी कलामाला कामधुक् कामरूपिणी"
  },
  {
    "id": "shloka-152",
    "type": "shloka",
    "sanskrit": "कलानिधिः काव्यकला रसज्ञा रसशेवधिः ।\nपुष्टा पुरातना पूज्या पुष्करा पुष्करेक्षणा"
  },
  {
    "id": "shloka-153",
    "type": "shloka",
    "sanskrit": "परंज्योतिः परंधाम परमाणुः परात्परा ।\nपाशहस्ता पाशहन्त्री परमन्त्रविभेदिनी"
  },
  {
    "id": "shloka-154",
    "type": "shloka",
    "sanskrit": "मूर्ताऽमूर्ताऽनित्यतृप्ता मुनिमानसहंसिका ।\nसत्यव्रता सत्यरूपा सर्वान्तर्यामिनी सती"
  },
  {
    "id": "shloka-155",
    "type": "shloka",
    "sanskrit": "ब्रह्माणी ब्रह्मजननी बहुरूपा बुधार्चिता ।\nप्रसवित्री प्रचण्डाऽऽज्ञा प्रतिष्ठा प्रकटाकृतिः"
  },
  {
    "id": "shloka-156",
    "type": "shloka",
    "sanskrit": "प्राणेश्वरी प्राणदात्री पञ्चाशत्पीठरूपिणी ।\nविशृङ्खला विविक्तस्था वीरमाता वियत्प्रसूः"
  },
  {
    "id": "shloka-157",
    "type": "shloka",
    "sanskrit": "मुकुन्दा मुक्तिनिलया मूलविग्रहरूपिणी ।\nभावज्ञा भवरोगघ्नी भवचक्रप्रवर्तिनी"
  },
  {
    "id": "shloka-158",
    "type": "shloka",
    "sanskrit": "छन्दःसारा शास्त्रसारा मन्त्रसारा तलोदरी ।\nउदारकीर्तिरुद्दामवैभवा वर्णरूपिणी"
  },
  {
    "id": "shloka-159",
    "type": "shloka",
    "sanskrit": "जन्ममृत्युजरातप्तजनविश्रान्तिदायिनी ।\nसर्वोपनिषदुद्घुष्टा शान्त्यतीतकलात्मिका"
  },
  {
    "id": "shloka-160",
    "type": "shloka",
    "sanskrit": "गम्भीरा गगनान्तस्था गर्विता गानलोलुपा ।\nकल्पनारहिता काष्ठाऽकान्ता कान्तार्धविग्रहा"
  },
  {
    "id": "shloka-161",
    "type": "shloka",
    "sanskrit": "कार्यकारणनिर्मुक्ता कामकेलितरङ्गिता ।\nकनत्कनकताटङ्का लीलाविग्रहधारिणी"
  },
  {
    "id": "shloka-162",
    "type": "shloka",
    "sanskrit": "अजा क्षयविनिर्मुक्ता मुग्धा क्षिप्रप्रसादिनी ।\nअन्तर्मुखसमाराध्या बहिर्मुखसुदुर्लभा"
  },
  {
    "id": "shloka-163",
    "type": "shloka",
    "sanskrit": "त्रयी त्रिवर्गनिलया त्रिस्था त्रिपुरमालिनी ।\nनिरामया निरालम्बा स्वात्मारामा सुधासृतिः"
  },
  {
    "id": "shloka-164",
    "type": "shloka",
    "sanskrit": "संसारपङ्कनिर्मग्नसमुद्धरणपण्डिता ।\nयज्ञप्रिया यज्ञकर्त्री यजमानस्वरूपिणी"
  },
  {
    "id": "shloka-165",
    "type": "shloka",
    "sanskrit": "धर्माधारा धनाध्यक्षा धनधान्यविवर्धिनी ।\nविप्रप्रिया विप्ररूपा विश्वभ्रमणकारिणी"
  },
  {
    "id": "shloka-166",
    "type": "shloka",
    "sanskrit": "विश्वग्रासा विद्रुमाभा वैष्णवी विष्णुरूपिणी ।\nअयोनिर्योनिनिलया कूटस्था कुलरूपिणी"
  },
  {
    "id": "shloka-167",
    "type": "shloka",
    "sanskrit": "वीरगोष्ठीप्रिया वीरा नैष्कर्म्या नादरूपिणी ।\nविज्ञानकलना कल्या विदग्धा बैन्दवासना"
  },
  {
    "id": "shloka-168",
    "type": "shloka",
    "sanskrit": "तत्त्वाधिका तत्त्वमयी तत्त्वमर्थस्वरूपिणी ।\nसामगानप्रिया सौम्या सदाशिवकुटुम्बिनी"
  },
  {
    "id": "shloka-169",
    "type": "shloka",
    "sanskrit": "सव्यापसव्यमार्गस्था सर्वापद्विनिवारिणी ।\nस्वस्था स्वभावमधुरा धीरा धीरसमर्चिता"
  },
  {
    "id": "shloka-170",
    "type": "shloka",
    "sanskrit": "चैतन्यार्घ्यसमाराध्या चैतन्यकुसुमप्रिया ।\nसदोदिता सदातुष्टा तरुणादित्यपाटला"
  },
  {
    "id": "shloka-171",
    "type": "shloka",
    "sanskrit": "दक्षिणादक्षिणाराध्या दरस्मेरमुखाम्बुजा ।\nकौलिनीकेवलाऽनर्घ्यकैवल्यपददायिनी"
  },
  {
    "id": "shloka-172",
    "type": "shloka",
    "sanskrit": "स्तोत्रप्रिया स्तुतिमती श्रुतिसंस्तुतवैभवा ।\nमनस्विनी मानवती महेशी मङ्गलाकृतिः"
  },
  {
    "id": "shloka-173",
    "type": "shloka",
    "sanskrit": "विश्वमाता जगद्धात्री विशालाक्षी विरागिणी ।\nप्रगल्भा परमोदारा परामोदा मनोमयी"
  },
  {
    "id": "shloka-174",
    "type": "shloka",
    "sanskrit": "व्योमकेशी विमानस्था वज्रिणी वामकेश्वरी ।\nपञ्चयज्ञप्रिया पञ्चप्रेतमञ्चाधिशायिनी"
  },
  {
    "id": "shloka-175",
    "type": "shloka",
    "sanskrit": "पञ्चमी पञ्चभूतेशी पञ्चसंख्योपचारिणी ।\nशाश्वती शाश्वतैश्वर्या शर्मदा शम्भुमोहिनी"
  },
  {
    "id": "shloka-176",
    "type": "shloka",
    "sanskrit": "धराधरसुता धन्या धर्मिणी धर्मवर्धिनी ।\nलोकातीता गुणातीता सर्वातीता शमात्मिका"
  },
  {
    "id": "shloka-177",
    "type": "shloka",
    "sanskrit": "बन्धूककुसुमप्रख्या बाला लीलाविनोदिनी ।\nसुमङ्गली सुखकरी सुवेषाढ्या सुवासिनी"
  },
  {
    "id": "shloka-178",
    "type": "shloka",
    "sanskrit": "सुवासिन्यर्चनप्रीताऽऽशोभना शुद्धमानसा ।\nबिन्दुतर्पणसन्तुष्टा पूर्वजा त्रिपुराम्बिका"
  },
  {
    "id": "shloka-179",
    "type": "shloka",
    "sanskrit": "दशमुद्रासमाराध्या त्रिपुराश्रीवशङ्करी ।\nज्ञानमुद्रा ज्ञानगम्या ज्ञानज्ञेयस्वरूपिणी"
  },
  {
    "id": "shloka-180",
    "type": "shloka",
    "sanskrit": "योनिमुद्रा त्रिखण्डेशी त्रिगुणाम्बा त्रिकोणगा ।\nअनघाऽद्भुतचारित्रा वाञ्छितार्थप्रदायिनी"
  },
  {
    "id": "shloka-181",
    "type": "shloka",
    "sanskrit": "अभ्यासातिशयज्ञाता षडध्वातीतरूपिणी ।\nअव्याजकरुणामूर्तिरज्ञानध्वान्तदीपिका"
  },
  {
    "id": "shloka-182",
    "type": "shloka",
    "sanskrit": "आबालगोपविदिता सर्वानुल्लङ्घ्यशासना ।\nश्रीचक्रराजनिलया श्रीमत्त्रिपुरसुन्दरी"
  },
  {
    "id": "shloka-183",
    "type": "shloka",
